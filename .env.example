# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hpr_portal
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DB_MAX_CONNECTIONS=20
DB_SSL=false # Set to true jika database remote mewajibkan koneksi SSL/TLS (cth: Cloud SQL, RDS)

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=100

# Authentication & Security
# Generate a strong 64-char random string in production (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=24h

# Security & CORS (comma-separated list of allowed origins, e.g., http://10.20.30.40,https://farebox.kcic.co.id)
ALLOWED_ORIGINS=http://localhost:3000
